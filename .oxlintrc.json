{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "eslint/no-underscore-dangle": [
      "error",
      { "allow": ["_tag"] }
    ],
    "no-console": "error",
    "no-debugger": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-nested-ternary": "error",
    "prefer-const": "error",
    "import/no-duplicates": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/error-boundaries": "error",
    "react/immutability": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/react-in-jsx-scope": "off",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "error"
  },
  "overrides": [
    {
      "files": [
        "tests/**/*.{ts,tsx,js,jsx}",
        "**/*.test.{ts,tsx,js,jsx}",
        "**/*.spec.{ts,tsx,js,jsx}"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    // Reylo infers .sql result types via the TypeScript 7.1 content mapper
    // against the migrated development database (tsc --runExternalCode).
    // Oxlint does not execute content mappers, so Reylo-derived row types
    // appear as error/any to its type engine and every row access warns.
    // tsc remains the authority for SQL typing: any schema/query drift is a
    // compile error there. These rules stay on everywhere else. The
    // database-boundary integration test reads Reylo-derived rows for the
    // same reason and is covered for the same rules. The user transport
    // functions pass Reylo-derived rows through (SQL already projects
    // client-safe shapes, e.g. dish_id::text); tsc is the authority that
    // the projection matches the consumer contract.
    // The auth integration test asserts on profile/favorite rows.
    // Catalog, admin-dashboard and admin-import tests assert on
    // Reylo-derived dish/import rows for the same reason.
    // TanStack server-function client types do not resolve inside Oxlint's
    // engine (route loaders calling user.functions); tsc checks them fully.
    // Operational scripts
    // (dynamic imports, raw postgres.js templates) are covered for the same
    // engine-limitation reason; tsc checks them fully.
    {
      "files": [
        "src/modules/food-discovery/server/repository/**/*.ts",
        "src/modules/food-discovery/server/operations/*.ts",
        "src/modules/user/server/repository/**/*.ts",
        "src/modules/user/server/operations/*.ts",
        "tests/integration/database-boundary.test.ts",
        "tests/integration/auth.test.ts",
        "tests/integration/admin-dashboard.test.ts",
        "tests/integration/admin-import-journey.test.ts",
        "tests/integration/admin-import-places-city.test.ts",
        "tests/integration/admin-places-crud.test.ts",
        "tests/integration/admin-places-resolver.test.ts",
        "tests/integration/admin-dish-update-names.test.ts",
        "tests/integration/admin-dish-update-places.test.ts",
        "tests/integration/catalog.test.ts",
        "tests/integration/user-food-preferences.test.ts",
        "src/modules/user/*.functions.ts",
        "src/modules/food-discovery/*.functions.ts",
        "src/routes/settings.account.tsx",
        "scripts/**/*.ts"
      ],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-redundant-type-constituents": "off"
      }
    },
    // Restaurant Discovery mirrors the food-discovery/user engine-limitation
    // override above: Reylo .sql row types and TanStack server-function client
    // types do not resolve inside Oxlint's engine (routes/components calling
    // restaurant.functions, operations reading Reylo rows). tsc with a migrated
    // database remains the authority for SQL typing and client contracts.
    // Muse Copilot and review-intelligence modules hit the same engine gap
    // (server-function clients, Reylo-derived rows); tsc checks them fully.
    {
      "files": [
        "src/modules/restaurant-discovery/server/repository/**/*.ts",
        "src/modules/restaurant-discovery/server/operations/*.ts",
        "src/modules/restaurant-discovery/*.functions.ts",
        "src/modules/restaurant-discovery/*.ts",
        "src/modules/restaurant-discovery/components/**/*.{ts,tsx}",
        "src/modules/muse-copilot/**/*.{ts,tsx}",
        "src/server/muse-copilot/**/*.ts",
        "src/server/review-intelligence/**/*.ts",
        "src/routes/muse.tsx",
        "src/routes/restaurants.tsx",
        "src/routes/restaurants.index.tsx",
        "src/routes/restaurants.$venueId.tsx",
        "src/routes/scan.tsx",
        "src/routes/admin.restaurants.tsx",
        "src/routes/dishes.tsx",
        "src/routes/dishes.index.tsx",
        "src/routes/api/menu-scans.ts",
        "tests/integration/restaurants.test.ts",
        "tests/integration/restaurant-customer-reviews.test.ts",
        "tests/integration/restaurant-customer-review-lifecycle.test.ts",
        "tests/integration/restaurant-customer-review-privacy.test.ts",
        "tests/integration/restaurant-customer-review-queue.test.ts",
        "tests/integration/restaurant-fx-cache.test.ts",
        "tests/integration/restaurant-publication-gating.test.ts",
        "tests/integration/menu-scan-config-status.test.ts",
        "tests/integration/menu-scan-hardening.test.ts",
        "tests/integration/menu-scan-promotion.test.ts",
        "tests/integration/menu-scan-provenance.test.ts",
        "tests/integration/restaurant-menu-pages.test.ts",
        "tests/integration/restaurant-photo-api.test.ts",
        "tests/unit/restaurant-*.test.{ts,tsx}",
        "tests/unit/scan-*.test.{ts,tsx}",
        "tests/unit/menu-scan-hardening.test.ts",
        "tests/unit/menu-scan-transport.test.ts",
        "tests/unit/menu-image.test.ts",
        "tests/unit/muse-menu.test.ts",
        "tests/unit/meta-client-abort.test.ts",
        "tests/browser/**/*.ts"
      ],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-redundant-type-constituents": "off"
      }
    },
    {
      "files": [
        "vite.config.ts",
        "**/*.config.{ts,js,mjs,cjs}",
        "tools/**/*.{ts,js}"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    // CI glue scripts ship as plain .mjs (runnable by stock node, no build
    // step) or as bun-run .ts (sharing the typed validator with tests) and
    // sit outside tsconfig, so the type engine resolves their
    // node:fs/process imports as error/any and every call warns. They validate
    // themselves at runtime with fail-closed argument and template checks;
    // keep the unsafe-* warns off here like the other engine-limitation
    // overrides above.
    {
      "files": [
        ".github/workflows/scripts/**/*.mjs",
        ".github/workflows/scripts/**/*.ts",
        "infra/scripts/**/*.mjs"
      ],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "repos/**",
    "**/repos/**",
    ".agents/**",
    ".claude/**",
    ".playwright/**",
    ".vite/**",
    "node_modules/**",
    ".output/**",
    "dist/**",
    "coverage/**",
    "**/routeTree.gen.ts",
    "**/*.generated.ts",
    "tools/oxlint/**",
    "probe-mapux.mjs"
  ]
}
