# Local development only. Copy to .env and fill in real values; never commit .env.
# cp .env.example .env
#
# The editor (VS Code + TypeScript 7 native preview) reads DATABASE_URL from
# this file — it does not see your shell's exports. Without it, Reylo cannot
# type .sql imports and they show as "cannot find module".

# Migrated dev database via infra/compose.ports.yaml (user/db `feastjourney`).
DATABASE_URL=postgres://<username>:<password>@127.0.0.1:5433/feastjourney

# Public base URL of this deployment. Used for OAuth callbacks and email links.
BETTER_AUTH_URL=http://localhost:3000

# Session encryption secret. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional owner bootstrap: the account holding this address receives the
# owner role right after signup. Leave unset and the first signup stays a
# plain member (ownership is then granted out of band with SQL).
# OWNER_EMAIL=you@example.com

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Facebook Login (https://developers.facebook.com/apps).
# Valid OAuth redirect URI: <BETTER_AUTH_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=replace-with-facebook-app-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-app-secret

# SMTP for verification and password-reset email. Local development can point
# at Mailpit (`docker run -p 1025:1025 -p 8025:8025 axllent/mailpit`).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=feastjourney
SMTP_PASSWORD=local-only-smtp-password
EMAIL_FROM=FeastJourney <noreply@feastjourney.example>

# Optional overrides (defaults shown).
# DATABASE_POOL_MAX=10
# CORS_ORIGINS=
# TRUSTED_PROXIES=
# RATE_LIMIT_PUBLIC=60
# RATE_LIMIT_PUBLIC_WINDOW_S=60
# RATE_LIMIT_SEARCH=20
# RATE_LIMIT_SEARCH_WINDOW_S=60
# RATE_LIMIT_COPILOT=10
# RATE_LIMIT_COPILOT_WINDOW_S=60
# RATE_LIMIT_ADMIN=10
# RATE_LIMIT_ADMIN_WINDOW_S=60
# REQUEST_TIMEOUT_MS=15000

# Restaurant observations and server-side Frankfurter v2 reference FX.
# FX_ENDPOINT=https://api.frankfurter.dev/v2/
# FX_REFRESH_HOURS=24
# FX_MAX_AGE_HOURS=72
# RESTAURANT_REVIEW_DAYS=90

# Browser-visible MapLibre style URL (public, never a secret). Build-time
# only: Vite embeds it into the client bundle, so changing it requires a
# rebuild (`bun run build`); a runtime value cannot fix an already-built
# bundle. Unset locally means the map shows its honest fallback while the
# list, addresses, and directions keep working. CI resolves the Actions
# repository variable VITE_MAP_STYLE_URL, else the validated CARTO Positron
# default (see src/shared/map-style-url.ts).
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
#
# Listening address for `bun run start` (Nitro runtime, not app config).
# HOST=127.0.0.1
# PORT=3000
# Reserved for future direct-connection use (e.g. bypassing a pooler for
# migrations or admin tasks). Declared in server config but not consumed
# by any application path today — leave unset.
# DATABASE_DIRECT_URL=
# Optional Muse dish-ranking integration. When MODEL_API_KEY is unset, the
# recommendation endpoint serves the deterministic baseline and says so;
# nothing else changes and startup never depends on these values.
# Operator principle: every MODEL_* value below flows through exactly as
# configured — defaults apply only when unset, there are no upper bounds,
# and an explicitly set invalid value (non-positive-integer, bad URL, wrong
# model shape) fails loudly naming field + reason. Provider-side limits are
# the provider's responsibility and surface as provider failures.
# RECOMMENDATION_PROVIDER=deterministic
# MODEL_API_KEY=
# MODEL_MODEL_ID=muse-spark-1.3
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_TIMEOUT_MS=15000
# MODEL_CANDIDATE_LIMIT=60
# MODEL_OUTPUT_LIMIT=10
# Per-call token budget for a ranking request (reasoning + output).
# MODEL_MAX_TOKENS=4000
# Operation budget for the whole recommend call (SQL + AI ranking).
# Must stay above MODEL_TIMEOUT_MS or the provider call can never complete.
# RECOMMEND_TIMEOUT_MS=120000
# Agentic recommendations (opt-in). All bounds below are operator-owned:
# unset uses the documented fallback (same numbers as shown), an explicitly
# set invalid value (non-positive integer) fails loudly naming field +
# reason, and an explicit valid value flows through exactly as configured
# (no upper bounds, no silent clamps). Explicit values are required in
# production (see infra/.env.production.example); locally the fallbacks apply.
# RECOMMEND_AGENT_ENABLED=false
# RECOMMEND_AGENT_MAX_ROUNDS=3
# RECOMMEND_AGENT_MAX_TOOL_CALLS=8
# RECOMMEND_AGENT_DETAILS_PER_CALL=10
# RECOMMEND_AGENT_CANDIDATE_POOL_CAP=60
# RECOMMEND_AGENT_FINAL_LIMIT=10
# MODEL_AGENT_TIMEOUT_MS=20000
# RECOMMEND_AGENT_DEADLINE_MS=90000

# Optional Muse conversational synthesis + food-photo identification.
# Synthesis runs only for signed-in members when MODEL_API_KEY is set and
# first-party facts exist; guests always receive deterministic catalog
# answers with honest provenance. Vision is disabled unless
# COPILOT_VISION_ENABLED=true and reuses the MODEL_* transport above.
# COPILOT_VISION_TIMEOUT_MS flows through exactly as configured (no upper
# bound); the photo server function derives its deadline from it.
# COPILOT_VISION_ENABLED=false
# COPILOT_VISION_TIMEOUT_MS=20000

# Optional review summarization + translation. Disabled unless
# REVIEW_INTELLIGENCE_ENABLED=true. Uses the same MODEL_API_KEY and
# MODEL_BASE_URL; no review call runs without an explicit opt-in.
# REVIEW_INTELLIGENCE_TIMEOUT_MS flows through exactly as configured (no
# upper bound).
# REVIEW_INTELLIGENCE_ENABLED=false
# REVIEW_INTELLIGENCE_TIMEOUT_MS=20000

# Optional web-research fallback. The copilot answers from the verified
# catalog first; research runs only when first-party results are empty and
# findings stay labeled as unverified web evidence. Disabled unless
# WEB_RESEARCH_ENABLED=true. Timeout/source/result knobs flow through
# exactly as configured (no upper bounds).
# WEB_RESEARCH_ENABLED=false
# WEB_RESEARCH_TIMEOUT_MS=20000
# WEB_RESEARCH_MAX_SOURCES=6
# WEB_RESEARCH_MAX_RESULTS=5
# WEB_RESEARCH_CACHE_TTL_MS=21600000
# WEB_RESEARCH_NEGATIVE_CACHE_TTL_MS=1800000

# Optional multilingual menu scanner (guest-accessible, private by default).
# Disabled unless MENU_SCANNER_ENABLED=true. Uses the same MODEL_API_KEY and
# MODEL_BASE_URL as dish ranking; no scan runs without an explicit opt-in.
# Every MENU_SCAN_* knob flows through exactly as configured (no upper
# bounds). Extraction runs detached server-side under MENU_SCAN_TIMEOUT_MS
# while the browser polls the scan view — there is no fixed 60s/95s chain
# to defeat, whatever value the operator sets.
# MENU_SCANNER_ENABLED=false
# MENU_SCAN_MODEL=muse-spark-1.3
# MENU_SCAN_TIMEOUT_MS=20000
# MENU_SCAN_RETRIES=1
# MENU_SCAN_MAX_RESPONSE_BYTES=1048576
# MENU_SCAN_MAX_IMAGES=6
# MENU_SCAN_MAX_IMAGE_BYTES=8388608
# MENU_SCAN_MAX_COMPLETION_TOKENS=12000
#
# Private menu-photo storage (Garage S3-compatible, server-only credentials).
# Photos stay in this bucket; structured extraction drafts live in Postgres.
# Personal scans expire after 24 hours, contributions after 30 days (SQL
# policy); expired Garage objects are removed by retryable cleanup.
# S3_ENDPOINT_INTERNAL=http://garage:3900
# S3_REGION=garage
# S3_BUCKET_PRIVATE=feastjourney-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Reads are same-origin authorized streams, never signed URLs. Run
# `bun run maintenance:menu-scans` on a schedule (cron/systemd) so expired
# scans, abandoned uploads and failed deletions are retried to completion.
